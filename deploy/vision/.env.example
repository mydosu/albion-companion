# 视觉机（llama.cpp + Qwen3-VL 4B）部署参数
# 复制成同目录的 .env 再按自己的机器改；.env 不进 Git。
#
# 标注说明：/props 是直接问生产上那个 llama-server 读到的（已确认）；
# 「未确认」= 没进过视觉机实机核对，按 llama.cpp / Qwen 官方仓库的通用默认给的值。

# ---- 容器 ----
# 未确认：生产用的镜像 tag（构建号）没核对过，server-cuda 是 CUDA 通用 tag。
VLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# 未确认：生产容器名没核对过。
CONTAINER_NAME=llama-vl

# ---- 模型 ----
# 宿主机上的模型目录（挂到容器里的 /models，只读）
MODEL_DIR=./models
# 已确认：/props 的 model_path = /models/Qwen3VL-4B-Instruct-Q4_K_M.gguf
MODEL_FILE=Qwen3VL-4B-Instruct-Q4_K_M.gguf
# 未确认：生产上的 mmproj 文件名没核对过；Qwen 官方 GGUF 仓库里的名字是这个，文件名对不上就改这里。
MMPROJ_FILE=mmproj-Qwen3VL-4B-Instruct-F16.gguf
# download_models.sh 用：Hugging Face 仓库和镜像站（国内可填 https://hf-mirror.com）
HF_REPO=Qwen/Qwen3-VL-4B-Instruct-GGUF
HF_ENDPOINT=https://huggingface.co

# ---- 端口 ----
# 已确认：生产上 8080 就是它的 /health
VLM_PORT=8080
# 未确认：宿主机绑的地址（0.0.0.0 表示所有网卡，靠防火墙限制来源）
VLM_LISTEN=0.0.0.0

# ---- 推理参数（6 GB 卡 + 4B 模型，只开视觉这一路）----
# 已确认：/props 的 n_ctx = 5120
CTX_SIZE=5120
# 已确认：/props 的 total_slots = 1
PARALLEL=1
# 未确认：显存层数没核对过；99 是「全放显存」的通用值，6 GB 装不下就往下降
N_GPU_LAYERS=99
# 额外命令行参数，空格分隔；例如 --flash-attn on
EXTRA_ARGS=

# ---- 防火墙（firewall.sh 用）----
# 未确认：网段按文档「只放行局域网和 tailnet」写，具体条目没进视觉机核对
# tailnet 段是 100.64.0.0/10；不想要 IPv6 就把 VLM_IPV6 置 0
ALLOWED_SOURCES="192.168.0.0/16 10.0.0.0/8 100.64.0.0/10"
VLM_IPV6=1
