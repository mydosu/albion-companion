# 视觉机（llama.cpp + Qwen3-VL 4B）部署参数
# 复制成同目录的 .env 再按自己的机器改；.env 不进 Git。
#
# 下面的默认值取自一台实机在跑的生产部署（docker inspect + /props + 模型目录逐项核对过），
# 不是通用猜测值；换机器时按实际情况改。

# ---- 容器 ----
# 生产钉的是通用 tag server-cuda（本地实际解析到构建号 b9859）；要固定构建就写成 server-cuda-b9859。
VLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
CONTAINER_NAME=llama-cpp

# ---- 模型 ----
# 宿主机上的模型目录（挂到容器里的 /models）
MODEL_DIR=./models
# /props 的 model_path = /models/Qwen3VL-4B-Instruct-Q4_K_M.gguf
MODEL_FILE=Qwen3VL-4B-Instruct-Q4_K_M.gguf
MMPROJ_FILE=mmproj-Qwen3VL-4B-Instruct-F16.gguf
# download_models.sh 用：Hugging Face 仓库和镜像站（国内可填 https://hf-mirror.com）
HF_REPO=Qwen/Qwen3-VL-4B-Instruct-GGUF
HF_ENDPOINT=https://huggingface.co

# ---- 端口 ----
# 宿主 8080 -> 容器 8080，/health 在 8080
VLM_PORT=8080
# 生产绑 0.0.0.0（IPv4 和 IPv6 都发布），靠 firewall.sh 限制来源
VLM_LISTEN=0.0.0.0

# ---- 推理参数（6 GB 卡 + 4B 模型，只开视觉这一路）----
# /props 的 n_ctx = 5120
CTX_SIZE=5120
# /props 的 total_slots = 1
PARALLEL=1
# 生产 -ngl 99：整模型进显存，6 GB 装得下
N_GPU_LAYERS=99
# 生产 --threads 4
THREADS=4
# 生产 CUDA_VISIBLE_DEVICES=0（单卡机器固定 0 就行）
GPU_DEVICE=0
# 额外命令行参数，空格分隔；例如 --flash-attn on
EXTRA_ARGS=

# ---- 防火墙（firewall.sh 用）----
# 生产只放行视觉机所在网段 + tailnet（100.64.0.0/10）；换网段就改这里
# 不想要 IPv6 就把 VLM_IPV6 置 0
ALLOWED_SOURCES="192.168.0.0/16 10.0.0.0/8 100.64.0.0/10"
VLM_IPV6=1
