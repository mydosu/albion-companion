   "kind": "真哭",
   "note": "短句、道歉、句末省略号",
   "text": "ごめんなさい……っ、わたし、もう……"
  },
  {
   "id": "sob2",
   "kind": "真哭",
   "note": "疑问+省略号、逗号在中",
   "text": "どうして……、こんなことに……っ"
