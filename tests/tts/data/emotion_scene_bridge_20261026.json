 "sentences": [
  {
   "id": "sad1",
   "kind": "低落平淡",
   "note": "陈述、句中有逗号",
   "text": "今日は、あまり上手くいきませんでした。少しだけ、休ませてください。"
  },
  {
   "id": "sad2",
   "kind": "低落平淡",
   "note": "陈述、道歉口吻",
   "text": "指揮官、ごめんなさい。私、今日は役に立てなかったみたいです。"
  },
  {
   "id": "sad3",
   "kind": "低落平淡",
   "note": "短句、自我安慰",
   "text": "大丈夫です。こういう日は、慣れていますから。"
  },
  {
   "id": "whi1",
   "kind": "耳语/悄悄话",
   "note": "提醒、带叮嘱",
   "text": "指揮官、少し声を潜めてください。先輩方が、すぐそこにいらっしゃいますから。"
  },
  {
   "id": "whi2",
   "kind": "耳语/悄悄话",
   "note": "分享秘密",
   "text": "ここだけの話ですよ。実は、私も少しだけ緊張しているんです。"
  },
  {
   "id": "whi3",
   "kind": "耳语/悄悄话",
   "note": "制止、句首象声词",
   "text": "しーっ。この作戦のことは、まだ誰にも言わないでくださいね。"
  },
  {
   "id": "shy1",
   "kind": "害羞",
   "note": "结巴、省略号多",
   "text": "あ、あの……その、手を、握ってもいいでしょうか。"
  },
  {
   "id": "shy2",
   "kind": "害羞",
   "note": "半句收尾",
   "text": "そんなに近くで見つめられると、私、なんだか落ち着かなくて……"
  },
  {
   "id": "shy3",
   "kind": "害羞",
   "note": "结巴、解释",
   "text": "こ、これ、受け取ってください。決して、深い意味はないんですけど……"
  },
  {
   "id": "coq1",
   "kind": "撒娇",
   "note": "请求、语气软",
   "text": "指揮官、今日はもう少しだけ、私と一緒にいてくれませんか。"
  },
  {
   "id": "coq2",
   "kind": "撒娇",
   "note": "撒娇、反问",
   "text": "ん……もう少しだけ、頭を撫でてほしいです。だめ、ですか？"
  },
  {
   "id": "coq3",
   "kind": "撒娇",
   "note": "长句、先让步再请求",
   "text": "指揮官が忙しいのは分かっています。でも、少しだけわがままを言わせてください。"
  },
  {
   "id": "cry1",
   "kind": "快哭/哽咽",
   "note": "自责、句中断续",
   "text": "私のせいで……みんなに、迷惑をかけてしまいました。"
  },
  {
   "id": "cry2",
   "kind": "快哭/哽咽",
   "note": "不安、问句收尾",
   "text": "指揮官は、私のことを、まだ信じてくれますか……"
  },
  {
   "id": "cry3",
   "kind": "快哭/哽咽",
   "note": "逞强、句中有长停顿",
   "text": "泣いてなんか、いません。……ちょっと、風が強かっただけですから。"
  },
  {
   "id": "exc1",
   "kind": "开心兴奋",
   "note": "感叹、短句连发",
   "text": "指揮官！見てください、今年の新茶が届きましたよ！"
  },
  {
   "id": "exc2",
   "kind": "开心兴奋",
   "note": "兴奋、两句感叹",
   "text": "今日の演習、全部上手くいきました！先輩も褒めてくださいました！"
  },
  {
   "id": "exc3",
   "kind": "开心兴奋",
   "note": "邀请、语气上扬",
   "text": "森の散歩、最高でしたよ！今度は指揮官もご一緒しましょうね！"
  },
  {
   "id": "ang1",
   "kind": "生气/不满",
   "note": "质问、语气压低",
   "text": "指揮官、さっきのご指示は、少し乱暴すぎませんか。"
  },
  {
   "id": "ang2",
   "kind": "生气/不满",
   "note": "长句、强硬",
   "text": "私は、そんなふうに扱われるために生まれてきたわけではありません。"
  },
  {
   "id": "ang3",
   "kind": "生气/不满",
   "note": "冷淡收场、句首省略号",
   "text": "……もう結構です。今日のところは、これで失礼します。"
  },
  {
   "id": "gen1",
   "kind": "温柔安慰",
   "note": "安抚、短句",
   "text": "大丈夫ですよ、指揮官。ゆっくりで、構いませんから。"
  },
  {
   "id": "gen2",
   "kind": "温柔安慰",
   "note": "安慰、两句",
   "text": "今日はもう、頑張らなくてもいいんです。私がそばにいますから。"
  },
  {
   "id": "gen3",
   "kind": "温柔安慰",
   "note": "邀请、句尾问号",
   "text": "ほら、お茶を淹れました。少しだけ、休みましょう？"
  }
 ],
