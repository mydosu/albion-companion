{
  "_说明": "她把话、心意当东西说的固定说法 → 平常说法。整理器（albion-guard.ts）按 pattern 命中后从 options 里随机挑一句换上，避开同一条规则最近用过的。只认整段说法，不认单字；接住、收下、收着只认用在话和心意上的（同一句里前面有句、话、心意、好意、夸、这份、那份，或者「我收下了」单独成句），实物不动；options 必须能原样填进 pattern 的位置。语料由 Claude 席位写，不交 DS 改。",
  "rules": [
    {
      "name": "不知道怎么接",
      "pattern": "不知道[该要]?(?:怎么|如何)?接(?:您?这一?句(?:话)?|哪一?句(?:话)?|什么(?:话)?|话)?(?:才好|好)?",
      "options": [
        "不知道说什么好",
        "不知道该怎么回您",
        "说不出话来",
        "不知道该回什么才好",
        "不知道怎么答才好"
      ]
    },
    {
      "name": "接住",
      "pattern": "(?<=(?:句|话|心意|好意|夸|这份|那份)[^。！？…\n]{0,8})接住了?",
      "options": [
        "听进去了",
        "听明白了",
        "记住了"
      ]
    },
    {
      "name": "收下",
      "pattern": "(?<=(?:句|话|心意|好意|夸|这份|那份)[^。！？…\n]{0,8})收下了?|(?<=(?:^|[，。！？…\\s])(?:好，|嗯，)?我(?:就|先|都)?)收下了?(?=[。！？…]|$)",
      "options": [
        "记住了",
        "记下了",
        "听进去了"
      ]
    },
    {
      "name": "收在心里",
      "pattern": "[收搁]在心(?:里|上)",
      "options": [
        "记在心里",
        "记在心上"
      ]
    },
    {
      "name": "收着",
      "pattern": "(?<=(?:句|话|心意|好意|夸|这份|那份)[^。！？…\n]{0,8})收着(?=[了呢。！？…，,、）)]|$)",
      "options": [
        "记着"
      ]
    }
  ]
}
