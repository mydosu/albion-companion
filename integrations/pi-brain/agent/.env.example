# 复制成 agent/.env 再填。.env 不进仓库；deploy.sh 不会覆盖已有的 .env。
# 格式：KEY=值，一行一个，值里的空格原样保留；留空的行等于没设。宿主启动时读一次，改完重启脑（bash stop.sh && bash start.sh）。

# ── 必填 ──
# 壳和宿主之间的口令。随机生成一个；壳那边 VITE_ALBION_LLM_KEY 必须写同一个值。
API_SERVER_KEY=

# ── 模型（没有 Magpie 时用；README「没有 Magpie 怎么配」）──
# 选哪个 provider/model。优先级：这两项 > /root/.pi/agent/settings.json（Magpie 写的）> 兜底 commandcode/deepseek/deepseek-v4-flash。
# provider 名必须是 agent/models.json 里 providers 下的键；两项都留空 = 保持原行为。
ALBION_PROVIDER=
ALBION_MODEL=
# provider 的 key：变量名取决于你在 agent/models.json 里怎么引用（apiKey 写变量名即可），下面是示例，按需改名。
# DEEPSEEK_API_KEY=
# COMMANDCODE_API_KEY=

# ── 可选：时区、端口、超时 ──
# 默认 Asia/Shanghai
# TZ=
# 脑端口（默认 8650）
# ALBION_BRAIN_PORT=
# 一轮最长秒数（默认 420）
# ALBION_RUN_TIMEOUT=

# ── 可选：记忆（OpenViking，教程阶段 7）──
# 两个地址写成一样，如 http://127.0.0.1:1933
OPENVIKING_ENDPOINT=
OPENVIKING_URL=
OPENVIKING_API_KEY=
OPENVIKING_ACCOUNT=
OPENVIKING_USER=
OPENVIKING_AGENT=
# 官方自动召回必须关，否则一轮里出现两份回忆
OPENVIKING_AUTO_RECALL=false

# ── 可选：她的眼睛（教程阶段 9）──
# 采集端地址；HIS=用户的屏幕/摄像头，可写多个逗号分隔（局域网在前）；MINE=她自己的
ALBION_EYES_HIS_URL=
ALBION_EYES_HIS_TOKEN=
ALBION_EYES_MINE_URL=
ALBION_EYES_MINE_TOKEN=
# 视觉模型服务地址（llama.cpp 等 OpenAI 兼容端点）
ALBION_EYES_VLM=
