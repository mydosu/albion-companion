{"Version": 3, "Type": 0, "Bounds": {"Width": 19.0, "Height": 15.0, "CenterX": 0.0, "CenterY": 0.0}, "FileReferences": {"Moc": "Moc_0.moc3", "Textures": ["Textures_0_0.png", "Textures_1_0.png"], "Physics": "Physics_0.json", "PhysicsV2": {"File": "Physics_0.json"}, "Motions": {"Idle": [{"Name": "idle", "File": "Motions_Idle_0_File_0.json", "FileLoop": true, "Priority": 2}], "Idle#1": [{"Name": "effect", "File": "Motions_Idle#1_0_File_0.json", "FileLoop": true, "Priority": 2}], "Touch_head.body.special": [{"Name": "head", "File": "Motions_Touch_head.body.special_0_File_0.json", "Priority": 4}, {"Name": "body", "File": "Motions_Touch_head.body.special_1_File_0.json", "Sound": "Motions_Touch_head.body.special_1_Sound_0.wav", "Text": "会有点痒...指挥官是想拍这里吗？", "Priority": 4}, {"Name": "special", "File": "Motions_Touch_head.body.special_2_File_0.json", "Sound": "Motions_Touch_head.body.special_2_Sound_0.wav", "Text": "指、指挥官，在这里姑且还是收敛点...", "Priority": 4}], "Action1": [{"Name": "touch_idle1", "File": "Motions_Action1_0_File_0.json", "Priority": 4, "NextMtn": "Action1:idle1"}, {"Name": "idle1", "File": "Motions_Action1_1_File_0.json", "FileLoop": true, "Priority": 4}, {"Name": "touch_idle2", "File": "Motions_Action1_2_File_0.json", "Priority": 5}], "Action2": [{"Name": "touch_idle3", "File": "Motions_Action2_0_File_0.json", "Priority": 4, "NextMtn": "Action2:idle2"}, {"Name": "idle2", "File": "Motions_Action2_1_File_0.json", "FileLoop": true, "Priority": 4}, {"Name": "touch_idle4", "File": "Motions_Action2_2_File_0.json", "Priority": 5}], "Action3": [{"Name": "touch_idle5", "File": "Motions_Action3_0_File_0.json", "Priority": 4, "NextMtn": "Action3:idle3"}, {"Name": "idle3", "File": "Motions_Action3_1_File_0.json", "FileLoop": true, "Priority": 4}, {"Name": "touch_idle6", "File": "Motions_Action3_2_File_0.json", "Priority": 5}], "Action4": [{"Name": "touch_idle7", "File": "Motions_Action4_0_File_0.json", "Priority": 4, "NextMtn": "Action4:idle4"}, {"Name": "idle4", "File": "Motions_Action4_1_File_0.json", "FileLoop": true, "Priority": 4}, {"Name": "touch_idle8", "File": "Motions_Action4_2_File_0.json", "Priority": 5}], "Action5": [{"Name": "touch_idle9", "File": "Motions_Action5_0_File_0.json", "Priority": 4, "NextMtn": "Action5:idle5"}, {"Name": "idle5", "File": "Motions_Action5_1_File_0.json", "FileLoop": true, "Priority": 4}, {"Name": "touch_idle10", "File": "Motions_Action5_2_File_0.json", "Priority": 5}], "Touch_drag": [{"Name": "touch_drag1", "File": "Motions_Touch_drag_0_File_0.json", "Priority": 4}, {"Name": "touch_drag2", "File": "Motions_Touch_drag_1_File_0.json", "Priority": 4}, {"Name": "touch_drag3", "File": "Motions_Touch_drag_2_File_0.json", "Priority": 4}, {"Name": "touch_drag4", "File": "Motions_Touch_drag_3_File_0.json", "Priority": 4}], "Tap": [{"Name": "main_3", "File": "Motions_Tap_0_File_0.json", "Sound": "Motions_Tap_0_Sound_0.wav", "Text": "是问这套礼服会不会不方便？嗯...战斗、做饭和家务的话都没什么问题呢。秘书舰的工作...不如明天就穿着这样去工作吧？欸？会让你分心？为什么？", "Priority": 3, "Interruptable": true}, {"Name": "mission", "File": "Motions_Tap_1_File_0.json", "Sound": "Motions_Tap_1_Sound_0.wav", "Text": "一起去完成任务吧。舰船们就是像这样跟随者指挥官成长的对吧。", "Priority": 3, "Interruptable": true}, {"Name": "main_2", "File": "Motions_Tap_2_File_0.json", "Sound": "Motions_Tap_2_Sound_0.wav", "Text": "虽然和森林浴的感觉不太一样，但是这里有一种别样的风情呢~指挥官也来这边试试吧？", "Priority": 3, "Interruptable": true}, {"Name": "mission_complete", "File": "Motions_Tap_3_File_0.json", "Sound": "Motions_Tap_3_Sound_0.wav", "Text": "已完成的任务报酬好像送来了。这是...领取前先确认下收件人地址是否正确比较好，对吧？", "Priority": 3, "Interruptable": true}, {"Name": "mail", "File": "Motions_Tap_4_File_0.json", "Sound": "Motions_Tap_4_Sound_0.wav", "Text": "好像来新邮件了...要确认吗？", "Priority": 3, "Interruptable": true}, {"Name": "main_1", "File": "Motions_Tap_5_File_0.json", "Sound": "Motions_Tap_5_Sound_0.wav", "Text": "没想到像这样在阁楼上吹着晚风、闻着淡淡的花香，也很惬意呢~咦？刚刚的感觉很好所以拍下来了？欸，有点太突然啦，指挥官！我还没摆好姿势呢...！", "Priority": 3, "Interruptable": true}, {"Name": "complete", "File": "Motions_Tap_6_File_0.json", "Sound": "Motions_Tap_6_Sound_0.wav", "Text": "是风的耳语...委托组的伙伴们回来了。您准备好去迎接后叫我便是。", "Priority": 3, "Interruptable": true}], "Mune": [{"Name": "mune", "Text": "✿", "Choices": [{"Text": "登录", "NextMtn": "Mune:login"}, {"Text": "回港", "NextMtn": "Mune:home"}, {"Text": "誓约", "NextMtn": "Mune:wedding"}, {"Text": "追踪", "NextMtn": "Mouse"}], "Priority": 5}, {"Name": "home", "File": "Motions_Mune_1_File_0.json", "Sound": "Motions_Mune_1_Sound_0.wav", "Text": "作战辛苦了，指挥官要来一杯茶吗？我和东煌的前辈们学了一下泡茶的技巧，希望你能喜欢。", "Priority": 4}, {"Name": "login", "File": "Motions_Mune_2_File_0.json", "Sound": "Motions_Mune_2_Sound_0.wav", "Text": "我得好好学习模特的技巧，至少要配得上这身漂亮的衣服呢...啊，欢迎回来指挥官~今天有什么吩咐吗？", "Priority": 4}, {"Name": "wedding", "File": "Motions_Mune_3_File_0.json", "Sound": "Motions_Mune_3_Sound_0.wav", "Text": "誓约…之戒？我，我可没向指挥官讨要戒指…是因为喜欢阿尔比恩所以才给我的吗？啊，是！嗯，是呢！都怪阿尔比恩太迟钝了，没能察觉到指挥官的心意十分抱歉。诶嘿嘿，谢谢您…♥", "Priority": 4}], "Mouse": [{"Name": "mouse disable", "Command": "mouse_tracking disable", "Priority": 5}, {"Name": "mouse enable", "Command": "mouse_tracking enable", "Priority": 5}]}}, "Controllers": {"ParamHit": {"Items": [{"Name": "照片", "Id": "touch_drag13", "HitArea": "照片", "Axis": 1, "Factor": 0.015, "ReleaseType": 3, "LockParam": true}, {"Name": "聚焦", "Id": "touch_drag8", "HitArea": "聚焦", "Axis": 0, "Factor": 0.01, "ReleaseType": 3, "LockParam": true}, {"Name": "闪光点", "Id": "touch_drag6", "HitArea": "闪光点", "Axis": 1, "Factor": 0.017, "ReleaseType": 3, "LockParam": true}, {"Name": "视角-左右", "Id": "touch_drag9", "HitArea": "手柄", "Axis": 0, "Factor": 0.012, "ReleaseType": 3, "LockParam": true}, {"Name": "视角-上下", "Id": "touch_drag10", "HitArea": "手柄", "Axis": 1, "Factor": -0.015, "ReleaseType": 3, "LockParam": true}, {"Name": "手柄-左右", "Id": "touch_drag11", "HitArea": "手柄", "Axis": 0, "Factor": 0.012, "ReleaseType": 3}, {"Name": "手柄-上下", "Id": "touch_drag12", "HitArea": "手柄", "Axis": 1, "Factor": -0.015, "ReleaseType": 3}, {"Name": "快门0", "Id": "touch_drag7", "HitArea": "快门", "Axis": 0, "Factor": 25.0, "Re