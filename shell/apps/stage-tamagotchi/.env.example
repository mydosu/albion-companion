# 复制成同目录的 .env.local 再填（.env.local 不进仓库），改完重新打包外壳才生效
# 她的脑：OpenAI 兼容接口
VITE_ALBION_LLM_BASE=http://127.0.0.1:8650/v1
VITE_ALBION_LLM_KEY=
# 嘴：TTS 桥（OpenAI 兼容语音接口）和音色名
VITE_ALBION_TTS_BASE=http://127.0.0.1:9881/v1
VITE_ALBION_TTS_MODEL=
# 流式 TTS
VITE_ALBION_STREAM_TTS_BASE=http://127.0.0.1:9885
# 耳朵：语音识别
VITE_ALBION_STT_BASE=http://127.0.0.1:9882/v1
# 眼睛：视觉模型（OpenAI 兼容，能看图）；留空就不预置
VITE_ALBION_VISION_BASE=
