# Template only. Copy to .local/runtime.env and fill locally; never commit the filled file.
# Existing launchers do not load this file automatically. Set process environment before launch.
TTS_TRANSLATE_KEY=
API_SERVER_KEY=
TTS_TRANSLATE_BACKEND=codex
TTS_TRANSLATE_CODEX_BIN=D:\AI\codex\bin\codex.cmd
TTS_TRANSLATE_BASE=https://api.deepseek.com/v1
TTS_TRANSLATE_MODEL=deepseek-flash
HERMES_ENV_FILE=
# 通用 OpenAI 兼容翻译线路：BACKEND=api + STYLE=chat（打 <BASE>/chat/completions）；默认 responses 不变
TTS_TRANSLATE_API_STYLE=responses
# 换角色：桥/后端默认音色名（默认 albion）
TTS_DEFAULT_VOICE=albion
