# 本机配置模板：复制成 config/local.env 再按需改（local.env 不入库，见 .gitignore）。
#
# 规则
#   * 一行一个 KEY=VALUE；空行忽略；整行以 # 开头的才是注释；值不要加引号。
#   * 值按字面取：不做 %VAR% 展开，也不做十六进制解析。
#   * 真环境变量优先：已经定义过的同名变量不会被本文件覆盖，所以临时调试可以
#     `set ALBION_...=x` 后在同一个窗口里启动，压过这里。
#   * 本文件优先于 bat 里的内置默认值（bat 里都是 `if not defined ... set ...`）。
#   * 注释掉的项＝用代码/bat 里的默认值；想改再取消注释。
#
# 谁读它
#   launch/load_env.bat。launch/start_all.bat 和每个服务启动 bat 开头都会 call 它，
#   所以「一键启动、单独双击某个服务、无窗口重启」三种起法都生效。
#   必须在 caller 的 `setlocal enabledelayedexpansion` 之前加载（值里的 ! 才不会被吃掉）。
#
# 不在这里的东西
#   * 壳的构建期变量 VITE_ALBION_*：在 shell/apps/stage-tamagotchi/.env.local（重新打包才生效）。
#   * 脑（WSL /root/albion-pi/agent/.env）：ALBION_* / OPENVIKING_* 属于那边，Windows 环境变量过不去 WSL。
#   * 眼睛采集端 token：同目录 token.txt（一台一份，照 token.txt.example 建）。
#   * 服务端口/路径里写死的部分（.venv、runtime、ships.json）不在本文件范围内。

# ── 通用 ────────────────────────────────────────────────────────────────────
# 服务结束后停住等按键（调试用）。start_all 静默启动会自己设成 1，所以别在这里打开。
# ALBION_SILENT=
# 服务的控制台是否可见（1＝每个服务一个窗口）。一键启动-dev.bat show 会设它，平时不用手写。
# ALBION_SHOW_CONSOLES=

# ── TTS 引擎二选一（一键启动按这里只拉起一个后端） ──────────────────────────
# irodori＝Irodori 五船日语特化后端（:9889）：延迟低、有情感/场景规划，但只念日语，
#          中文台词要先由桥翻译成日语（壳的流式网关走 /v2/prepare → /v2/plan → /v2/render）。
# gsv    ＝GPT-SoVITS/Denia 中文角色后端（:9880）：中文原文直接念，不用翻译，
#          但不是流式（整条 wav）、首句慢，需要 tts/GPT-sovits 安装目录和显卡。
ALBION_TTS_ENGINE=irodori
# Denia 后端跑在哪个设备：cuda（默认，is_half 自动开）或 cpu（is_half 自动关）；
# 只影响启动器生成的临时 yaml，入库的 tts/gsv/tts_infer_denia.yaml 不动
ALBION_GSV_DEVICE=cuda

# ── TTS 资产位置（换机器/挪目录时只改这几行） ──────────────────────────────
# Irodori 各船参考音目录（默认 <仓库>\tts\ref_audio，不入库）
# ALBION_REF_AUDIO=
# GPT-SoVITS 安装目录（上游代码 + runtime + 权重，整目录不入库）；Denia 后端用
ALBION_GSV_ROOT=D:\AI\Wife\tts\GPT-sovits
# Denia 参考音（默认 <仓库>\tts\ref_audio\output.wav_0009342720_0009558400.wav）
# ALBION_DENIA_REF=
# Denia 后端端口（start_denia.bat 用）
# ALBION_DENIA_PORT=9880
# Irodori 桥目录（bridge_v2 复用 v1 翻译腿时用；默认 tts\irodori）
# ALBION_BRIDGE_DIR=
# ── 声音后端正本：Irodori（:9889, tts/irodori/start_backend.bat） ───────────
# 每段渲染的日文/中文原文进日志（出坏句时能回溯）
TTS_LOG_TEXT=1
# 受控声音字幕（把情绪/发声提示写成 caption 送进 TTS）
ALBION_VOICE_CAPTION=1

# ── 声音桥：翻译 + OpenAI 兼容 /v1/audio/speech（:9881, start_bridge.bat） ──
# 翻译腿：codex＝Command Code 主路（Codex CLI 兜底）；api＝独立 key 的 HTTP 线路
TTS_TRANSLATE_BACKEND=codex
TTS_TRANSLATE_BASE=https://api.deepseek.com/v1
TTS_TRANSLATE_MODEL=deepseek-flash
# api 线路的协议形态：responses（历史默认）或 chat（通用 /chat/completions）
TTS_TRANSLATE_API_STYLE=responses
# api 线路的 key（空＝改读下面的 key 文件）；这个值是机密，只写进 local.env，不要提交
TTS_TRANSLATE_KEY=
TTS_TRANSLATE_KEY_FILE=D:\AI\_secrets\command code.txt
# Codex CLI 的位置（本机 PATH 上实际是 npm shim，与这个默认值不同，按机器改）
TTS_TRANSLATE_CODEX_BIN=D:\AI\codex\bin\codex.cmd
# 句末 emoji 与受控字幕；默认都开
ALBION_VOICE_EMOJI=1
# 默认音色（albion / taihou / shinano / brest / jinshi）
TTS_DEFAULT_VOICE=albion
# 翻译首腿跟着脑当前模型走（1＝开）；脑那台机器不可达时可以设 0
TTS_BRAIN_ROUTE=1
TTS_BRAIN_HEALTH_URL=http://127.0.0.1:8650/health

# ── 流式语音网关（:9885, tts/stream/start_stream.bat） ──────────────────────
# 切句/计划器版本（引擎契约里要带这个数）
ALBION_PLAN_VERSION=4
# 句间停顿整形（0＝关掉，回到不整形的原始节奏）
ALBION_GAP_SHAPE=1
# 情感融合策略：默认关；想试效果再开（未用标注集校准）
# ALBION_EMOTION_POLICY=fusion_v1
# 跨句指令（「接下来都小声说」）作用域：默认开
# ALBION_CROSS_SENTENCE=1

# ── 耳朵：STT（:9882, ear/start_ear.bat） ───────────────────────────────────
# 引擎：paraformer（CPU 常驻，默认）或 whisper
ALBION_STT_ENGINE=paraformer
ALBION_STT_PORT=9882
# auto | cuda | cpu（paraformer 固定走 CPU）
ALBION_STT_DEVICE=auto
# 模型根目录默认 <ear>\models\modelscope\iic，换机器才需要改
# ALBION_FUNASR_ROOT=
# 只有 whisper 引擎才用：模型名/路径（默认 small）与启动预热
# ALBION_STT_MODEL=small
# ALBION_STT_PRELOAD=1

# ── 眼睛：采集端（:8790, eyes/start_eyes.bat） ──────────────────────────────
# ffmpeg 路径；留空＝用 PATH 里的 ffmpeg
# ALBION_FFMPEG=
# DirectShow 摄像头名；留空＝默认摄像头
# ALBION_CAM=
# 摄像头画面顺时针转正角度：0 / 90 / 180 / 270
# ALBION_CAM_ROTATE=0

# ── 挂件（widget/AlbionStatus.vbs，不走 load_env，只作记录） ────────────────
# 指定 pythonw.exe；留空＝按 PATH 上的 pythonw/pyw/py 依次找
# ALBION_PYTHONW=
